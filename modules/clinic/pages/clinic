<script>
    // ── Helpers ──────────────────────────────────────────────────────────────

    // Calculate age from a birthdate string (YYYY-MM-DD)
    function calculateAge(birthdate) {
        if (!birthdate) return '';
        const today = new Date();
        const dob   = new Date(birthdate);
        let age = today.getFullYear() - dob.getFullYear();
        const monthDiff = today.getMonth() - dob.getMonth();
        if (monthDiff < 0 || (monthDiff === 0 && today.getDate() < dob.getDate())) age--;
        return age;
    }

    // Set today's date as default for appointment date
    function setDefaultDate() {
        const today = new Date().toISOString().split('T')[0];
        document.getElementById('appointmentDate').value = today;
    }

    // Set default time (current time)
    function setDefaultTime() {
        const now = new Date();
        const hours = now.getHours().toString().padStart(2, '0');
        const minutes = now.getMinutes().toString().padStart(2, '0');
        document.getElementById('appointmentTime').value = `${hours}:${minutes}`;
    }

    // Fill the Patient Information fields from a data object
    function fillPatientInfo(data) {
        document.getElementById('studentNumberDisplay').value = data.student_number ?? '';
        document.getElementById('patientName').value = (data.first_name + ' ' + data.last_name).trim();
        document.getElementById('patientGender').value = data.gender ?? '';
        document.getElementById('patientCourse').value = data.course ?? '';
        document.getElementById('patientYearLevel').value = data.year_level ?? '';
        document.getElementById('patientAge').value = calculateAge(data.birthdate);

        // Unlock all form fields
        enableFormFields(true);
        
        // Set default date and time
        setDefaultDate();
        setDefaultTime();
    }

    function enableFormFields(enabled) {
        const fields = [
            'temperature', 'bloodPressure', 'heartRate', 'respiratoryRate', 
            'oxygenSaturation', 'nurse', 'visitType', 'appointmentDate', 
            'appointmentTime', 'symptoms', 'diagnosis', 'treatment', 'notes',
            'submitBtn'
        ];
        
        fields.forEach(id => {
            const element = document.getElementById(id);
            if (element) {
                element.disabled = !enabled;
            }
        });
    }

    function resetForm() {
        // Clear patient info
        ['studentNumberDisplay', 'patientName', 'patientAge',
         'patientGender', 'patientCourse', 'patientYearLevel'].forEach(id => {
            const element = document.getElementById(id);
            if (element) element.value = '';
        });
        
        // Clear vital signs
        ['temperature', 'bloodPressure', 'heartRate', 'respiratoryRate', 'oxygenSaturation'].forEach(id => {
            const element = document.getElementById(id);
            if (element) element.value = '';
        });
        
        // Clear appointment details
        document.getElementById('nurse').value = '';
        document.getElementById('visitType').value = '';
        document.getElementById('appointmentDate').value = '';
        document.getElementById('appointmentTime').value = '';
        
        // Clear notes
        document.getElementById('symptoms').value = '';
        document.getElementById('diagnosis').value = '';
        document.getElementById('treatment').value = '';
        document.getElementById('notes').value = '';
        
        // Clear student select
        document.getElementById('studentSelect').value = '';
        document.getElementById('studentNumber').value = '';
        
        // Disable all form fields
        enableFormFields(false);
    }

    // ── Search by typed student number ───────────────────────────────────────
    document.getElementById('searchBtn').addEventListener('click', () => {
        const studentNumber = document.getElementById('studentNumber').value.trim();

        if (!studentNumber) {
            alert('Please enter a student number.');
            return;
        }

        // Try to match from the already-loaded <select> options
        const select = document.getElementById('studentSelect');
        const options = Array.from(select.options);
        const match = options.find(opt => opt.value === studentNumber);

        if (match) {
            select.value = studentNumber;

            fillPatientInfo({
                student_number: match.value,
                first_name: match.dataset.firstname,
                last_name: match.dataset.lastname,
                gender: match.dataset.gender,
                birthdate: match.dataset.birthdate,
                course: match.dataset.course,
                year_level: match.dataset.yearlevel,
            });
        } else {
            alert('Student not found.');
            resetForm();
        }
    });

    // ── Clear button ─────────────────────────────────────────────────────────
    document.getElementById('clearBtn').addEventListener('click', () => {
        document.getElementById('studentNumber').value = '';
        resetForm();
    });

    // ── Select box change — pick student directly from dropdown ──────────────
    document.getElementById('studentSelect').addEventListener('change', function() {
        const selected = this.options[this.selectedIndex];

        if (!selected.value) {
            resetForm();
            return;
        }

        document.getElementById('studentNumber').value = selected.value;

        fillPatientInfo({
            student_number: selected.value,
            first_name: selected.dataset.firstname,
            last_name: selected.dataset.lastname,
            gender: selected.dataset.gender,
            birthdate: selected.dataset.birthdate,
            course: selected.dataset.course,
            year_level: selected.dataset.yearlevel,
        });
    });

    // ── Reset Form button ────────────────────────────────────────────────────
    document.getElementById('resetFormBtn').addEventListener('click', () => {
        if (confirm('Are you sure you want to reset the form?')) {
            resetForm();
        }
    });

    // ── Close Result button ──────────────────────────────────────────────────
    document.getElementById('closeResultBtn').addEventListener('click', () => {
        document.getElementById('result').style.display = 'none';
    });

    // ── Form submission ───────────────────────────────────────────────────────
    const form = document.getElementById('clinicForm');
    const resultDiv = document.getElementById('result');
    const resultContent = document.getElementById('resultContent');

    form.addEventListener('submit', function(e) {
        e.preventDefault();

        // Validate required fields
        const patientName = document.getElementById('patientName').value;
        const nurse = document.getElementById('nurse').value;
        const visitType = document.getElementById('visitType').value;
        const appointmentDate = document.getElementById('appointmentDate').value;
        const appointmentTime = document.getElementById('appointmentTime').value;

        if (!patientName || !nurse || !visitType || !appointmentDate || !appointmentTime) {
            alert('Please fill in all required fields (Patient, Nurse, Visit Type, Date, and Time)!');
            return;
        }

        // Gather all form data for display
        const temperature = document.getElementById('temperature').value || 'Not recorded';
        const bloodPressure = document.getElementById('bloodPressure').value || 'Not recorded';
        const heartRate = document.getElementById('heartRate').value || 'Not recorded';
        const respiratoryRate = document.getElementById('respiratoryRate').value || 'Not recorded';
        const oxygenSaturation = document.getElementById('oxygenSaturation').value || 'Not recorded';
        const symptoms = document.getElementById('symptoms').value || 'None reported';
        const diagnosis = document.getElementById('diagnosis').value || 'Not specified';
        const treatment = document.getElementById('treatment').value || 'None prescribed';
        const notes = document.getElementById('notes').value || 'None';

        resultContent.innerHTML = `
            <p><strong>Patient:</strong> ${patientName} (${document.getElementById('patientGender').value}, ${document.getElementById('patientAge').value} yrs)</p>
            <p><strong>Student #:</strong> ${document.getElementById('studentNumberDisplay').value}</p>
            <p><strong>Course & Year:</strong> ${document.getElementById('patientCourse').value} - ${document.getElementById('patientYearLevel').value}</p>
            <hr>
            <p><strong>Nurse:</strong> ${nurse}</p>
            <p><strong>Visit Type:</strong> ${visitType}</p>
            <p><strong>Date & Time:</strong> ${appointmentDate} at ${appointmentTime}</p>
            <hr>
            <p><strong>Vital Signs:</strong></p>
            <ul>
                <li>Temperature: ${temperature} °C</li>
                <li>Blood Pressure: ${bloodPressure} mmHg</li>
                <li>Heart Rate: ${heartRate} bpm</li>
                <li>Respiratory Rate: ${respiratoryRate} breaths/min</li>
                <li>Oxygen Saturation: ${oxygenSaturation}%</li>
            </ul>
            <hr>
            <p><strong>Symptoms:</strong> ${symptoms}</p>
            <p><strong>Diagnosis:</strong> ${diagnosis}</p>
            <p><strong>Treatment/Medication:</strong> ${treatment}</p>
            <p><strong>Additional Notes:</strong> ${notes}</p>
        `;
        
        resultDiv.style.display = 'block';
        
        // Optional: Scroll to result
        resultDiv.scrollIntoView({ behavior: 'smooth' });

        // Reset the form after successful submission
        resetForm();
    });

    // Initialize: make sure form is disabled on page load
    document.addEventListener('DOMContentLoaded', function() {
        enableFormFields(false);
        
        // Add input validation for blood pressure format
        document.getElementById('bloodPressure').addEventListener('input', function(e) {
            const value = e.target.value;
            if (value && !/^\d{2,3}\/\d{2,3}$/.test(value)) {
                e.target.setCustomValidity('Please use format: 120/80');
            } else {
                e.target.setCustomValidity('');
            }
        });
    });
</script>