<?php
include_once __DIR__ . '/../../../database/db.php';
include_once __DIR__ . '/../classes/student.php';

$studentClass = new Student();
$allStudents = $studentClass->getAllStudents();

if (!$allStudents) $allStudents = [];

// Get search parameter from URL
$searchTerm = isset($_GET['search']) ? trim($_GET['search']) : '';

// Filter students based on search term
if (!empty($searchTerm)) {
    $filteredStudents = array_filter($allStudents, function($student) use ($searchTerm) {
        $searchTermLower = strtolower($searchTerm);
        return strpos(strtolower($student['student_number']), $searchTermLower) !== false ||
               strpos(strtolower($student['first_name']), $searchTermLower) !== false ||
               strpos(strtolower($student['last_name']), $searchTermLower) !== false ||
               strpos(strtolower($student['course'] ?? ''), $searchTermLower) !== false ||
               strpos(strtolower($student['email'] ?? ''), $searchTermLower) !== false;
    });
    $students = array_values($filteredStudents);
} else {
    $students = $allStudents;
}

// Pagination logic
$rowsPerPage = 10;
$totalStudents = count($students);
$totalPages = ceil($totalStudents / $rowsPerPage);
$currentPage = isset($_GET['page']) && is_numeric($_GET['page']) ? (int)$_GET['page'] : 1;
$currentPage = max(1, min($currentPage, $totalPages > 0 ? $totalPages : 1));
$offset = ($currentPage - 1) * $rowsPerPage;
$studentsOnPage = array_slice($students, $offset, $rowsPerPage);

// Build pagination URLs with search term
function buildPaginationUrl($page, $searchTerm) {
    $params = [];
    if ($page > 1) $params['page'] = $page;
    if (!empty($searchTerm)) $params['search'] = urlencode($searchTerm);
    return '?' . http_build_query($params);
}
