<script>
// Global variables
let currentSearchTerm = '<?= $searchTerm ?>';

// Global function for edit button
function editStudent(studentNumber) {
    if (!studentNumber) return;
    
    // Set the select dropdown value
    const select = document.getElementById('studentID');
    if (select) {
        select.value = studentNumber;
    }
    
    // Trigger search
    searchStudent(studentNumber);
}

// Search function
function searchStudent(studentNumber) {
    if (!studentNumber) {
        alert('Please select a student.');
        document.getElementById('studentInfo').style.display = 'none';
        return;
    }

    // Show loading state
    const updateMessage = document.getElementById('updateMessage');
    updateMessage.className = 'message info';
    updateMessage.style.display = 'block';
    updateMessage.textContent = 'Loading student data...';

    fetch(`../handlers/get_student.php?student_number=${encodeURIComponent(studentNumber)}`)
        .then(res => {
            if (!res.ok) throw new Error('Network response error');
            return res.json();
        })
        .then(student => {
            if (student && !student.error) {
                document.getElementById('studentInfo').style.display = 'block';
                
                // Fill the form with student data
                document.getElementById('hiddenNumber').value = student.student_number || '';
                document.getElementById('originalNumber').value = student.student_number || '';
                document.getElementById('firstName').value = student.first_name || '';
                document.getElementById('lastName').value = student.last_name || '';
                document.getElementById('gender').value = student.gender || '';
                document.getElementById('dob').value = student.date_of_birth || '';
                document.getElementById('phone').value = student.phone || '';
                document.getElementById('email').value = student.email || '';
                document.getElementById('course').value = student.course || '';
                document.getElementById('yearLevel').value = student.year_level || '';
                document.getElementById('address').value = student.address || '';

                // Hide loading message
                updateMessage.style.display = 'none';
                
                // Scroll to form
                document.getElementById('studentInfo').scrollIntoView({ behavior: 'smooth' });
            } else {
                alert('Student not found!');
                document.getElementById('studentInfo').style.display = 'none';
                updateMessage.style.display = 'none';
            }
        })
        .catch(err => {
            console.error('Error:', err);
            alert('Error fetching student data. Please try again.');
            document.getElementById('studentInfo').style.display = 'none';
            updateMessage.style.display = 'none';
        });
}

// Function to perform search via AJAX
function performSearch(searchTerm) {
    // Show loading indicator
    document.getElementById('tableBody').innerHTML = '<tr><td colspan="11" class="no-data">Searching...</td></tr>';
    
    // Update current search term
    currentSearchTerm = searchTerm;
    
    // Get current page
    const urlParams = new URLSearchParams(window.location.search);
    const page = urlParams.get('page') || 1;
    
    // Build fetch URL
    let fetchUrl = `../handlers/search_students.php?search=${encodeURIComponent(searchTerm)}&page=${page}`;
    
    fetch(fetchUrl)
        .then(res => {
            if (!res.ok) throw new Error('Network response error');
            return res.json();
        })
        .then(data => {
            // Update table body
            updateTableBody(data.students);
            
            // Update pagination
            updatePagination(data.currentPage, data.totalPages, data.totalStudents);
            
            // Update results info
            updateResultsInfo(data.start, data.end, data.totalStudents);
            
            // Update search title
            const searchTitle = document.getElementById('searchTitle');
            if (searchTerm) {
                searchTitle.textContent = `- Search Results for "${searchTerm}"`;
            } else {
                searchTitle.textContent = '';
            }
            
            // Update URL without reloading
            const url = new URL(window.location.href);
            if (searchTerm) {
                url.searchParams.set('search', searchTerm);
            } else {
                url.searchParams.delete('search');
            }
            url.searchParams.set('page', data.currentPage);
            window.history.pushState({}, '', url);
        })
        .catch(err => {
            console.error('Error:', err);
            document.getElementById('tableBody').innerHTML = '<tr><td colspan="11" class="no-data">Error performing search. Please try again.</td></tr>';
        });
}

// Function to update table body
function updateTableBody(students) {
    const tbody = document.getElementById('tableBody');
    
    if (!students || students.length === 0) {
        tbody.innerHTML = '<tr><td colspan="11" class="no-data">No students found.</td></tr>';
        return;
    }
    
    let html = '';
    students.forEach(s => {
        html += `<tr>
            <td>${escapeHtml(s.student_number)}</td>
            <td>${escapeHtml(s.first_name)}</td>
            <td>${escapeHtml(s.last_name)}</td>
            <td>${escapeHtml(s.gender || '')}</td>
            <td>${escapeHtml(s.date_of_birth || '')}</td>
            <td>${escapeHtml(s.phone || '')}</td>
            <td>${escapeHtml(s.email || '')}</td>
            <td>${escapeHtml(s.course || '')}</td>
            <td>${escapeHtml(s.year_level || '')}</td>
            <td>${escapeHtml(s.address || '')}</td>
            <td><button type="button" class="btn-edit" onclick="editStudent('${escapeHtml(s.student_number)}')">Edit</button></td>
        </tr>`;
    });
    
    tbody.innerHTML = html;
}

// Function to update pagination
function updatePagination(currentPage, totalPages, totalStudents) {
    const container = document.getElementById('paginationContainer');
    
    if (totalPages <= 1) {
        container.innerHTML = '';
        return;
    }
    
    let html = `
        <div class="pagination">
            <div class="pagination-info">
                Page ${currentPage} of ${totalPages}
            </div>
            <div class="pagination-controls">
    `;
    
    if (currentPage > 1) {
        html += `<a href="#" class="page-link" title="First Page" onclick="changePage(1); return false;">««</a>`;
        html += `<a href="#" class="page-link" title="Previous Page" onclick="changePage(${currentPage - 1}); return false;">«</a>`;
    }
    
    const window = 2;
    const start = Math.max(1, currentPage - window);
    const end = Math.min(totalPages, currentPage + window);
    
    if (start > 1) {
        html += '<span class="page-ellipsis">...</span>';
    }
    
    for (let i = start; i <= end; i++) {
        if (i === currentPage) {
            html += `<span class="page-current">${i}</span>`;
        } else {
            html += `<a href="#" class="page-link" onclick="changePage(${i}); return false;">${i}</a>`;
        }
    }
    
    if (end < totalPages) {
        html += '<span class="page-ellipsis">...</span>';
    }
    
    if (currentPage < totalPages) {
        html += `<a href="#" class="page-link" title="Next Page" onclick="changePage(${currentPage + 1}); return false;">»</a>`;
        html += `<a href="#" class="page-link" title="Last Page" onclick="changePage(${totalPages}); return false;">»»</a>`;
    }
    
    html += '</div></div>';
    container.innerHTML = html;
}

// Function to update results info
function updateResultsInfo(start, end, total) {
    const startSpan = document.getElementById('startResult');
    const endSpan = document.getElementById('endResult');
    const totalSpan = document.getElementById('totalResults');
    
    if (startSpan && endSpan && totalSpan) {
        startSpan.textContent = start;
        endSpan.textContent = end;
        totalSpan.textContent = total;
    }
}

// Function to change page
function changePage(page) {
    performSearch(currentSearchTerm, page);
}

// Function to escape HTML
function escapeHtml(text) {
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
}

